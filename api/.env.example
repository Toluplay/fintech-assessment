# Copy to .env for local overrides. Every value has a safe development default.
API_PORT=3000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173

# Development-only secrets. In production these MUST come from a secrets manager.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Artificial latency (ms) so loading states are visible while developing. 0 disables it.
MOCK_LATENCY_MS=600

# Login attempts allowed per minute per IP (brute-force protection).
LOGIN_RATE_LIMIT=5
