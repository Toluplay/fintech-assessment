# Base URL the browser uses for API calls. Keep it same-origin (`/api`) so the
# refresh cookie stays SameSite=Strict; Vite (dev) or a reverse proxy (prod)
# forwards it to the NestJS server.
VITE_API_BASE_URL=/api

# Where the dev/preview proxy forwards `/api` requests (Node-side only).
VITE_API_PROXY_TARGET=http://localhost:3000
