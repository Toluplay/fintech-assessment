{
  "name": "veridian-fintech",
  "version": "1.0.0",
  "private": true,
  "description": "Veridian - customer-facing fintech web app (React + TypeScript) with a mock NestJS REST API",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cross-env API_PORT=3000 npm run start:dev --workspace api",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start:prod": "cross-env NODE_ENV=production SERVE_WEB=true node api/dist/main"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
